rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Bootstrap vsnrylabs@gmail.com as admin with mandatory verified email check
      return isSignedIn() && (
        (request.auth.token.email == 'vsnrylabs@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUserProfile(data) {
      return data.keys().hasAll(['name', 'email', 'status'])
        && data.keys().size() <= 12
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 200
        && data.status in ['pending', 'approved', 'rejected']
        && ( !('preferredFormat' in data) || (data.preferredFormat in ['Debate', 'Análisis', 'Opinión']) )
        && ( !('customHostVoice' in data) || (data.customHostVoice is string && data.customHostVoice.size() <= 100) )
        && ( !('episodesCount' in data) || (data.episodesCount is number) )
        && ( !('autoArchive' in data) || (data.autoArchive is bool) )
        && ( !('monthlyTokenUsage' in data) || (data.monthlyTokenUsage is number) )
        && ( !('contentFilters' in data) || true )
        && ( !('updatedAt' in data) || true );
    }

    function isValidPodcastHistory(data) {
      return data.keys().hasAll(['id', 'title', 'status', 'date'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.status in ['Ready', 'Failed', 'Processing']
        && data.date is string && data.date.size() <= 50
        && ( !('topic' in data) || (data.topic is string && data.topic.size() <= 500) )
        && ( !('contentType' in data) || (data.contentType is string && data.contentType.size() <= 200) )
        && ( !('format' in data) || (data.format is string && data.format.size() <= 100) )
        && ( !('duration' in data) || (data.duration is string && data.duration.size() <= 20) )
        && ( !('sourceUrls' in data) || (data.sourceUrls is list && data.sourceUrls.size() <= 100) );
    }

    function isValidDraft(data) {
      return data.keys().hasAll(['updatedAt'])
        && data.keys().size() <= 10
        && ( !('topic' in data) || (data.topic is string && data.topic.size() <= 500) )
        && ( !('scriptText' in data) || (data.scriptText is string && data.scriptText.size() <= 100000) )
        && ( !('reportText' in data) || (data.reportText is string && data.reportText.size() <= 100000) )
        && ( !('rawScript' in data) || (data.rawScript is string && data.rawScript.size() <= 100000) )
        && ( !('scriptLines' in data) || (data.scriptLines is list) )
        && ( !('format' in data) || (data.format is string && data.format.size() <= 100) )
        && ( !('contentType' in data) || (data.contentType is string && data.contentType.size() <= 200) );
    }

    function isValidVoiceProfile(data) {
      return data.keys().hasAll(['role', 'pitch', 'speed', 'warmth', 'updatedAt'])
        && data.keys().size() <= 8
        && data.role in ['Host', 'Expert', 'Analyst']
        && ( !('voiceName' in data) || (data.voiceName is string && data.voiceName.size() <= 100) )
        && data.pitch is number
        && data.speed is number
        && data.warmth is number
        && data.updatedAt is string;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['topic', 'content', 'createdAt'])
        && data.keys().size() <= 5
        && data.topic is string && data.topic.size() <= 500
        && data.content is string;
    }

    function isValidSavedTopic(data) {
      return data.keys().hasAll(['topic', 'createdAt'])
        && data.keys().size() <= 3
        && data.topic is string && data.topic.size() <= 500;
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidId(userId) 
                    && isValidUserProfile(incoming());
                    
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'preferredFormat', 'customHostVoice', 'episodesCount', 'autoArchive', 'contentFilters', 'monthlyTokenUsage', 'updatedAt']) && incoming().status == existing().status) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isAdmin() || isOwner(userId);

      match /drafts/{draftId} {
        allow read, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(draftId) && isValidDraft(incoming());
        allow delete: if isOwner(userId);
      }

      match /voiceProfiles/{profileId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(profileId) && isValidVoiceProfile(incoming());
        allow delete: if isOwner(userId);
      }

      match /history/{historyId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(historyId) && isValidPodcastHistory(incoming());
        allow update: if isOwner(userId) && isValidId(historyId) && isValidPodcastHistory(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'status', 'duration', 'sourceUrls', 'topic']);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /reports/{reportId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(reportId) && isValidReport(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /savedTopics/{topicId} {
        allow read, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(topicId) && isValidSavedTopic(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
