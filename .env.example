# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION & SECURITY SPECIFICATION
# ==============================================================================
# Security Policy:
# 1. SERVER SECRETS (GEMINI_API_KEY, FIREBASE_PRIVATE_KEY, etc.) MUST NEVER be
#    prefixed with NEXT_PUBLIC_ or exported to browser client bundles.
# 2. Public variables (NEXT_PUBLIC_*) are only for non-sensitive identifiers.
# ==============================================================================

# Gemini API Key (Server-side secret required for AI generation and grounding)
GEMINI_API_KEY=

# Firebase Client Configuration (Public project identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vsnry-labs-b4d4f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vsnry-labs-b4d4f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vsnry-labs-b4d4f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Run Infrastructure Region
NEXT_PUBLIC_CLOUD_RUN_REGION=us-east1

# Firebase Admin SDK Configuration (Server-side ONLY - Keep strictly private)
FIREBASE_PROJECT_ID=vsnry-labs-b4d4f
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Application Runtime Environment
NODE_ENV=production

# Google Cloud / Vertex AI Configuration (Enable to leverage Google Cloud Vertex AI credits)
VERTEX_AI=true
USE_VERTEX_AI=true
VERTEX_PROJECT_ID=vsnry-labs-b4d4f
VERTEX_LOCATION=us-central1
