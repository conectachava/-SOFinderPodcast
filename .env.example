NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-studio-sourcefinderpod-80c11e99-655e-465a-9a26-79fcdf2a8ccc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-studio-sourcefinderpod-80c11e99-655e-465a-9a26-79fcdf2a8ccc
